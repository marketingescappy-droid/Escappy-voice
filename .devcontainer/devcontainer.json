{
  "name": "Escappy Voice",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "postStartCommand": "nohup .venv/bin/python -m streamlit run app.py --server.headless=true --server.port=8501 > /tmp/escappy-voice.log 2>&1 < /dev/null &",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Escappy Voice",
      "onAutoForward": "openBrowserOnce"
    }
  }
}
